# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyWaitCntInsertionPass --print-output
#
# RequiresXCntForVolatileVMEM needs an XNACK-replay drain before volatile/atomic
# VMEM ops. Atomics always drain; non-atomic VMEM load/store drains when marked
# volatile/coherent (glc or device/system scope).
#
# Pattern:
#   buffer_store_b32             ordinary VMEM store; should not get xcnt
#   buffer_store_b32 SCOPE_DEV   volatile VMEM store; must get s_wait_xcnt 0
#   buffer_load_b32  SCOPE_DEV   volatile VMEM load; must get s_wait_xcnt 0
#   flat_store_b32   glc         volatile FLAT store; must get s_wait_xcnt 0
#   flat_load_b32    glc         volatile FLAT load; must get s_wait_xcnt 0
#   buffer_atomic_add_f32        MUBUF VMEM RMW; must get s_wait_xcnt 0
#   flat_atomic_dec_u32          FLAT VMEM RMW; must get s_wait_xcnt 0
#   global_atomic_inc_u32        GLOBAL VMEM RMW; must get s_wait_xcnt 0
#
# CHECK-LABEL: @waitcnt_insertion_xcnt_atomic_vmem
# CHECK-NOT: s_wait_xcnt
# CHECK: buffer_store_b32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: buffer_store_b32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: buffer_load_b32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: flat_store_b32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: flat_load_b32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: buffer_atomic_add_f32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: flat_atomic_dec_u32
# CHECK-NEXT: s_wait_xcnt"(0)
# CHECK-NEXT: global_atomic_inc_u32

st.func @waitcnt_insertion_xcnt_atomic_vmem() {
^entry:
  "st.buffer_store_b32"(v2, v3, s[0:3], s4)
  "st.buffer_store_b32"(v12, v32, s[60:63], s46) { mod.mubuf = { offen = true, offset12 = 0, glc = false, slc = false, nt = false, lds = false, scope = "SCOPE_DEV" } }
  v13 = "st.buffer_load_b32"(v33, s[60:63], s46) { mod.mubuf = { offen = true, offset12 = 0, glc = false, slc = false, nt = false, lds = false, scope = "SCOPE_DEV" } }
  "st.flat_store_b32"(v[20:21], v22, s[10:11]) { mod.flat = { offset12 = 0, glc = true, slc = false, lds = false } }
  v23 = "st.flat_load_b32"(v[24:25], s[10:11]) { mod.flat = { offset12 = 0, glc = true, slc = false, lds = false } }
  v0 = "st.buffer_atomic_add_f32"(v0, v1, s[0:3], s4)
  v5 = "st.flat_atomic_dec_u32"(v[6:7], v8, s[6:7])
  v9 = "st.global_atomic_inc_u32"(v10, v11, s[8:9])
}
